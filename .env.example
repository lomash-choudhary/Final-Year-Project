# ==============================================================================
# BOVINE DISEASE RAG — ENVIRONMENT
# Copy to `.env` and fill in. Everything here has a free tier.
# Full reference: DOCS/05_ENVIRONMENT_VARIABLES.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GEMINI  — embeddings (primary) + chat (last-resort LLM fallback)
#    Free key: https://aistudio.google.com/apikey
#    REQUIRED for ingestion.
# ------------------------------------------------------------------------------
GEMINI_API_KEY = ""
# Optional second key for embeddings — same GEMINI_EMBEDDING_MODEL, so same
# vector space. Used once the primary exhausts EMBED_MAX_RETRIES on a batch, and
# stays active for the rest of the run. The free quota is per Google Cloud
# PROJECT: a key from the same project buys nothing. Identical to the primary = ignored.
GEMINI_FALLBACK_API_KEY = ""

# ------------------------------------------------------------------------------
# MODEL NAMES LIVE HERE AND NOWHERE ELSE
#
# No model identifier is hardcoded anywhere in the codebase — not as a constant,
# not as a default, not as a fallback. Providers rename and decommission models
# on their own schedule; keeping the names in one .env file means a dead model is
# one line to edit instead of a grep across the source. The flip side: a blank
# model variable disables that tier, and `python -m scripts.doctor` will tell you.
#
# Verify names before trusting them:
#   Groq    https://console.groq.com/docs/models
#   Gemini  https://ai.google.dev/gemini-api/docs/models
# ------------------------------------------------------------------------------

# Embedding model used for ingestion AND query vectors — one name, no fallback.
# This must stay identical to the model the Qdrant collection was built with:
# the Gemini embedding family mixes widths across generations (3072 for
# gemini-embedding-001, 768 for text-embedding-004 and embedding-001), so a
# different name here is not a degraded answer, it is a different vector space.
# Changing it means re-ingesting with --wipe. Blank disables the Gemini tier.
GEMINI_EMBEDDING_MODEL = "models/gemini-embedding-001"

# Last-resort chat model, tried after every Groq target fails. Blank = no Gemini
# chat fallback at all (the ladder just ends one rung earlier).
GEMINI_CHAT_MODEL = "gemini-2.5-flash"


# ------------------------------------------------------------------------------
# 2. GROQ — reasoning engine. Two keys = two free quotas chained.
#    Free keys: https://console.groq.com/keys
#    Fallback order: GROQ_API_KEY -> GROQ_FALLBACK_API_KEY -> Gemini chat.
# ------------------------------------------------------------------------------
GROQ_API_KEY = ""
GROQ_FALLBACK_API_KEY = ""

# The two tiers of the fallback ladder. PRIMARY answers the user (responder /
# advisor); FAST runs the mechanical nodes — planner, grader, clarifier,
# translator — that fire on every single query. Both are required when a Groq key
# is set: a key with no model name is a dead target and gets dropped.
#
# GROQ_FAST_MODEL must NOT be a reasoning model. The mechanical nodes cap
# max_tokens hard (grader 160, planner 180, clarifier 300, translator 400), and a
# reasoning model spends that budget on its hidden channel before emitting any
# content: openai/gpt-oss-20b returns finish_reason="length" with content="" on
# the planner prompt at 180. The parsers then silently fall back to their
# defaults on every query — no error, just a permanently degraded graph. Verify a
# replacement returns a parseable body within 160 tokens before setting it here.
# PRIMARY is uncapped (responder/advisor pass max_tokens=None), so a reasoning
# model is fine there.
GROQ_PRIMARY_MODEL = "openai/gpt-oss-120b"
GROQ_FAST_MODEL = "qwen/qwen3.8-27b"

# ------------------------------------------------------------------------------
# 2b. PER-STAGE GROQ KEYS  (optional but recommended)
#
# The pipeline has four extra stages that each make their own model call:
#   translate  Hindi -> English on the way in, English -> Hindi on the way out
#   clarifier  decides whether to ask follow-up questions
#   advisor    writes the final "treat at home or call a vet" answer
#
# Giving each stage its own free Groq key means a busy stage cannot rate-limit
# the others. Leave any of them blank and that stage simply shares GROQ_API_KEY.
#
# The keys are never used in isolation: a stage tries its own key first, then
# falls back to GROQ_API_KEY, then GROQ_FALLBACK_API_KEY, then Gemini. So a
# dedicated key that runs out degrades instead of failing.
#
# Create extra free keys at https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_TRANSLATE_API_KEY = ""
GROQ_CLARIFIER_API_KEY = ""
GROQ_ADVISOR_API_KEY = ""

# Translation is mechanical — a small model does it well and costs far less.
# Blank falls back to GROQ_FAST_MODEL (a configured value, not a literal).
GROQ_TRANSLATE_MODEL = "llama-3.1-8b-instant"


# ------------------------------------------------------------------------------
# 3. QDRANT — vector database
#    Local Docker :  QDRANT_CLUSTER_ENDPOINT = "http://localhost:6333"  (no API key)
#    Qdrant Cloud :  https://cloud.qdrant.io  (free 1GB cluster)
# ------------------------------------------------------------------------------
QDRANT_CLUSTER_ENDPOINT = "http://localhost:6333"
QDRANT_API_KEY = ""                          # leave blank when running locally
QDRANT_COLLECTION = "bovine_disease_rag"

# Points per upsert request. A 3072-dim vector is ~12 KB before payload, so 64
# points is an ~800 KB write — enough to time out a throttled free cloud cluster.
# Lower this if you see "write operation timed out"; raise it on local Docker.
QDRANT_UPSERT_BATCH = "24"
QDRANT_TIMEOUT = "120"


# ------------------------------------------------------------------------------
# 4. EMBEDDING PIPELINE  (quota-protection knobs)
# ------------------------------------------------------------------------------
# auto   = try Gemini, fall back to a local model if unreachable  (recommended)
# gemini = Gemini only, fail loudly if unavailable
# local  = fully offline sentence-transformers, zero API calls
EMBEDDING_PROVIDER = "auto"

# Offline fallback embedding model (sentence-transformers). Required unless
# EMBEDDING_PROVIDER = "gemini". Downloads weights on first use, then runs
# offline forever. Changing it changes the vector dimension → re-ingest --wipe.
LOCAL_EMBEDDING_MODEL = "sentence-transformers/all-mpnet-base-v2"

EMBED_BATCH_SIZE = "16"      # texts per Gemini batch request

# TEXTS per minute, NOT requests per minute. Gemini's free embedding quota is
# `embed_content_free_tier_requests: limit 100` and it is charged per text — a
# batch of 16 costs 16 units, not 1. Keep this under 100.
EMBED_MAX_RPM = "90"
EMBED_MAX_RETRIES = "5"      # retries on 429 per key; the provider's retryDelay is honoured,
                             # then the batch moves to GEMINI_FALLBACK_API_KEY

# On-disk embedding cache. Re-ingesting unchanged text costs zero API quota.
EMBEDDING_CACHE_ENABLED = "true"
EMBEDDING_CACHE_PATH = ".cache/embeddings.sqlite3"


# English-only ingestion. The agent graph is English between translate_in and
# translate_out, so non-English papers are skipped (and their old vectors
# removed). Shares are fractions 0-1. To re-check already-indexed files after
# changing these, run with --force.
INGEST_ENGLISH_ONLY = "true"
INGEST_MIN_LATIN_SHARE = "0.9"          # share of letters in Latin script (catches Cyrillic, CJK...)
INGEST_MIN_ENGLISH_STOPWORDS = "0.12"   # share of words that are English function words


# ------------------------------------------------------------------------------
# 5. CHUNKING & RETRIEVAL
# ------------------------------------------------------------------------------
CHUNK_SIZE = "1400"
CHUNK_OVERLAP = "200"
MIN_CHUNK_CHARS = "120"

RETRIEVAL_TOP_K = "20"       # candidates pulled from Qdrant
RERANK_TOP_N = "5"           # kept after FlashRank cross-encoder
MIN_RELEVANCE_SCORE = "0.0"  # drop Qdrant hits below this cosine score

# FlashRank cross-encoder checkpoint (local ONNX, zero API cost). Blank leaves
# the choice to FlashRank's own default — the one model name this project does
# not own, because the library ships it. Names: https://github.com/PrithivirajDamodaran/FlashRank
RERANKER_MODEL = ""


# ------------------------------------------------------------------------------
# 6. AGENT BEHAVIOUR
# ------------------------------------------------------------------------------
ENABLE_SELF_CORRECTION = "true"   # grader node: rewrite query + retry once if context is weak
MAX_REFINEMENTS = "1"
MAX_CONTEXT_CHARS = "18000"       # context budget handed to the LLM (Groq TPM guard)

# --- Consumer assistant ---
# Accept Hindi (Devanagari or Roman script) and answer in the same language.
# Detection is free; a model is only called when the input is not English.
ENABLE_TRANSLATION = "true"

# Ask follow-up questions before advising on a sick animal ("since when?",
# "any fever?"). Only fires when the answers would actually change the advice.
ENABLE_CLARIFICATION = "true"
MAX_CLARIFICATION_ROUNDS = "1"    # never ask twice in a row
MAX_FOLLOW_UP_QUESTIONS = "2"

# Farmer-facing advice is written without [1] citation markers, since the
# sources panel is hidden for consumers. Set true to put them back.
SHOW_CITATIONS_IN_ADVICE = "false"

# off | fast | full
#   fast = deterministic zero-cost rails (recommended)
#   full = fast rails + NeMo Guardrails (needs `nemoguardrails`, burns Groq calls)
GUARDRAILS_MODE = "fast"

LLM_CACHE_ENABLED = "true"
LLM_CACHE_TTL = "900"


# ------------------------------------------------------------------------------
# 7. OBSERVABILITY
#    Logfire free key: https://logfire.pydantic.dev
#    Leave LOGFIRE_TOKEN blank to trace to console only — nothing breaks.
# ------------------------------------------------------------------------------
LOGFIRE_TOKEN = ""
LOGFIRE_ENVIRONMENT = "dev"

LANGSMITH_TRACING = "true"
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "bovine-disease-rag"


# ------------------------------------------------------------------------------
# 8. UI + EVALS
# ------------------------------------------------------------------------------
BACKEND_URL = "http://localhost:8000"

# Browser origins allowed to call this API. Comma-separated, or "*" for any.
# Origins only — scheme + host (+ port). No trailing slash, no path.
# Leave "*" locally; set your real domains in production so only your own app
# can spend your free-tier quota. Production value for this project:
#   CORS_ORIGINS = "https://final-year-project-frontend-mauve.vercel.app,http://localhost:5001,http://localhost:5000"
CORS_ORIGINS = "*"

# A third Groq key used ONLY by the RAGAS judge, so eval runs never exhaust the
# quota your live app is using. Falls back to GROQ_API_KEY when blank.
JUDGE_GROQ = ""

# Judge model for the RAGAS pass. Blank falls back to GROQ_FAST_MODEL — judging
# is mechanical and the big quota is better spent answering real queries.
JUDGE_MODEL = ""

# Local sentence-transformers model RAGAS uses for its embedding-based metrics.
# Runs offline, costs no quota. Required to run `python -m evals.metrics`.
EVAL_EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"


# ------------------------------------------------------------------------------
# 9. OPTIONAL — Portkey LLM gateway
#    NOT required. This project ships its own gateway (app/llm/router.py) with the
#    same fallback/retry/cache behaviour. See DOCS/09_LLM_GATEWAY.md before enabling.
# ------------------------------------------------------------------------------
ENABLE_PORTKEY = "false"
PORTKEY_API_KEY = ""
